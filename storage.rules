rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // CertiGen templates (background images uploaded for certificate design)
    match /certigen/templates/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // CertiGen submissions and ZIP archives
    match /certigen/submissions/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Background images
    match /backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback rule
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}