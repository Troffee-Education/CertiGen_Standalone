rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Any authenticated user in Firebase Auth has admin permissions
    function isAdmin() {
      return request.auth != null;
    }

    // -- Users Collection --
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // -- CertiGen Events --
    // Events: publicly readable for claim forms, writable by authenticated admins
    match /certigen_events/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -- CertiGen Magic Links --
    match /certigen_magic_links/{document} {
      allow read, write: if isAdmin();
    }

    // -- CertiGen Submissions --
    // Submissions: PII is admin-only on read. Submissions allowed for claims.
    match /certigen_submissions/{document} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}